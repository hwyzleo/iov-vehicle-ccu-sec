{
    "unicast": "127.0.0.1",
    "netmask": "255.255.255.0",
    "network": "lo",
    
    "applications": [
        {
            "name": "cgw-sec",
            "id": "0x1234"
        }
    ],
    
    "services": [
        {
            "service": "0x1234",
            "instance": "0x5678",
            "unreliable": "30502",
            "reliable": {
                "port": "30502",
                "protocol": "TCP"
            },
            "events": [],
            "eventgroups": []
        }
    ],
    
    "routing": "cgw-sec",
    
    "service-discovery": {
        "enable": "true",
        "multicast": "239.0.0.1",
        "port": "30490",
        "protocol": "UDP",
        "initial_delay_min": "10",
        "initial_delay_max": "100",
        "repetitions_base_delay": "200",
        "repetitions_max": "10",
        "cyclic_offer_delay": "2000",
        "request_response_delay": "1500"
    },
    
    "payload-sizes": [
        {
            "service": "0x1234",
            "instance": "0x5678",
            "max-payload-size": "65535"
        }
    ],
    
    "max-configured-queuing-time": "5000",
    
    "threads": {
        "io": "2",
        "app": "2",
        "shutdown": "1"
    },
    
    "logging": {
        "console": "true",
        "file": {
            "enable": "true",
            "path": "/var/log/cgw-sec/vsomeip.log"
        },
        "level": "info"
    }
}
